<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_manifiesto_carga" model="report.paperformat">
        <field name="name">Manifiesto de carga A4 horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_manifiesto_carga" model="ir.actions.report">
        <field name="name">Manifiesto de carga</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_manifiesto_carga.report_manifiesto_carga_test</field>
        <field name="report_file">account_manifiesto_carga.report_manifiesto_carga_test</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_manifiesto_carga"/>
        <field name="print_report_name">'Manifiesto de carga - %s' % (object.name or '')</field>
    </record>

</odoo>
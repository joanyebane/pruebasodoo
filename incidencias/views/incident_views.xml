<odoo>
    <record id="view_incidencias_request_tree" model="ir.ui.view">
        <field name="name">incidencias.request.tree</field>
        <field name="model">incidencias.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="subject"/>
                <field name="priority"/>
                <field name="requester_id"/>
                <field name="assigned_id"/>
                <field name="request_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_incidencias_request_form" model="ir.ui.view">
        <field name="name">incidencias.request.form</field>
        <field name="model">incidencias.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Iniciar" type="object" invisible="state != 'new'" class="oe_highlight" groups="incidencias.group_incident_manager"/>
                    <button name="action_resolve" string="Resolver" type="object" invisible="state != 'in_progress'" class="oe_highlight" groups="incidencias.group_incident_manager"/>
                    <button name="action_close" string="Cerrar" type="object" invisible="state != 'resolved'" groups="incidencias.group_incident_manager"/>
                    <button name="action_reset" string="Reiniciar" type="object" invisible="state == 'new'" groups="incidencias.group_incident_manager"/>
                    <button name="%(action_incidencias_reply_wizard)d" string="Responder" type="action" class="oe_highlight" groups="incidencias.group_incident_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="subject"/>
                            <field name="description"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="requester_id" readonly="1"/>
                            <field name="assigned_id" readonly="1" groups="incidencias.group_incident_user,!incidencias.group_incident_manager"/>
                            <field name="assigned_id" groups="incidencias.group_incident_manager"/>
                            <field name="request_date" readonly="1"/>
                            <field name="start_date" readonly="1" groups="incidencias.group_incident_user,!incidencias.group_incident_manager"/>
                            <field name="start_date" groups="incidencias.group_incident_manager"/>
                            <field name="end_date" readonly="1" groups="incidencias.group_incident_user,!incidencias.group_incident_manager"/>
                            <field name="end_date" groups="incidencias.group_incident_manager"/>
                            <field name="estimated_time" readonly="1" groups="incidencias.group_incident_user,!incidencias.group_incident_manager"/>
                            <field name="estimated_time" groups="incidencias.group_incident_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Respuestas">
                            <field name="reply_ids" readonly="1" groups="incidencias.group_incident_user,!incidencias.group_incident_manager">
                                <tree>
                                    <field name="reply_date"/>
                                    <field name="user_id"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                            <field name="reply_ids" groups="incidencias.group_incident_manager">
                                <tree editable="bottom">
                                    <field name="reply_date"/>
                                    <field name="user_id"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_incidencias_request_search" model="ir.ui.view">
        <field name="name">incidencias.request.search</field>
        <field name="model">incidencias.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="priority"/>
                <field name="requester_id"/>
                <field name="assigned_id"/>
                <filter string="Nuevas" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="En curso" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resueltas" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Responsable" name="group_assigned" context="{'group_by': 'assigned_id'}"/>
                    <filter string="Prioridad" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_incidencias_request" model="ir.actions.act_window">
        <field name="name">Incidencias</field>
        <field name="res_model">incidencias.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_incidencias_root" name="Incidencias" sequence="10" groups="incidencias.group_incident_user,incidencias.group_incident_manager"/>
    <menuitem id="menu_incidencias_request" name="Solicitudes" parent="menu_incidencias_root" action="action_incidencias_request" sequence="20" groups="incidencias.group_incident_user,incidencias.group_incident_manager"/>
</odoo>

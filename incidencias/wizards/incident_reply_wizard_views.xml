<odoo>
    <record id="view_incidencias_reply_wizard_form" model="ir.ui.view">
        <field name="name">incidencias.reply.wizard.form</field>
        <field name="model">incidencias.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Responder incidencia">
                <group>
                    <field name="message"/>
                </group>
                <footer>
                    <button name="action_add_reply" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_incidencias_reply_wizard" model="ir.actions.act_window">
        <field name="name">Responder incidencia</field>
        <field name="res_model">incidencias.reply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('incidencias.group_incident_manager'))]"/>
    </record>
</odoo>

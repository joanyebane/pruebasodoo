<odoo>
    <record id="action_report_incident" model="ir.actions.report">
        <field name="name">Incidencia</field>
        <field name="model">incidencias.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">incidencias.report_incident_document</field>
        <field name="report_file">incidencias.report_incident_document</field>
        <field name="binding_model_id" ref="model_incidencias_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_incident_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Incidencia <span t-field="o.name"/></h2>
                        <p><strong>Asunto:</strong> <span t-field="o.subject"/></p>
                        <p><strong>Prioridad:</strong> <span t-field="o.priority"/></p>
                        <p><strong>Solicitante:</strong> <span t-field="o.requester_id"/></p>
                        <p><strong>Responsable:</strong> <span t-field="o.assigned_id"/></p>
                        <p><strong>Estado:</strong> <span t-field="o.state"/></p>
                        <p><strong>Fecha solicitud:</strong> <span t-field="o.request_date"/></p>
                        <p><strong>Inicio:</strong> <span t-field="o.start_date"/></p>
                        <p><strong>Fin:</strong> <span t-field="o.end_date"/></p>
                        <p><strong>Tiempo estimado:</strong> <span t-field="o.estimated_time"/></p>
                        <h3>Descripción</h3>
                        <p t-field="o.description"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

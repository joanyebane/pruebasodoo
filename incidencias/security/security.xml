<odoo>
    <record id="group_incident_user" model="res.groups">
        <field name="name">Usuario de incidencias</field>
        <field name="category_id" ref="base.module_category_services_management"/>
        <field name="users" eval="[(4, ref('base.user_demo'))]"/>
    </record>

    <record id="group_incident_manager" model="res.groups">
        <field name="name">Responsable de incidencias</field>
        <field name="category_id" ref="base.module_category_services_management"/>
        <field name="implied_ids" eval="[(4, ref('incidencias.group_incident_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- que se vea bonito y por columnas el menu de las incidencias-->
    <record id="sport_issue_view_tree" model="ir.ui.view">
        <field name="name">sport_issue.view.tree</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
<!-- multi edit = 1 és para marcar múltiples issues y editarlos a la vez-->            
            <tree multi_edit="1" string="Issues">
<!-- handle es el widget para poder mover/ordenar las incidencias de forma interactiva-->
                <field name="sequence" widget="handle"/>
                <field name="name"/>
<!--optional para elegir si queremos verlo o no, icono arriba derecha-->                
                <field name="date" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="sport_issue_view_form" model="ir.ui.view">
<!-- form és lo que se va a ver al crear una incidencia-->
        <field name="name">sport_issue.view.form</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <form string="Issues">
                <header>
<!-- El menu transaccional (arriba a la derecha)que muestran el estando en el que se encuentra-->
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
<!-- Botones to open, draft y done-->
                    <button string="To draft" name="action_draft" type="object" class="oe_highlight"/>
                    <button string="To open" invisible="state not in ('draft')" name="action_open" type="object" class="oe_highlight"/>
                    <button string="Done" invisible="state not in ('open')" name="action_done" type="object" class="oe_highlight"/>
<!-- botón para a la hora de crear una incidencia añadir una etiqueta -->
                    <button string="Add tag" name="action_add_tag" groups="sports_association.res_groups_sports_association_manager" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
<!-- El título de la página-->
                            <field name="name" placeholder="Issue Name"></field>                       
                        </h1>
                    </div>

                    <group>
<!-- Aquí, el primer bloque de group és lo que va a mostrarse a la izquierda y el segundo bloque lo que se muestra a la derecha en la interfaz final-->
                        <group>
<!-- En incidencias no se debe poder acceder al usuario ni crear usuarios nuevos de manera rápida, pero si desde vista de formulario.
En las etiquetas de las incidencias no se debe poder crear ninguna etiqueta-->
                            <field name="assigned"/>
<!-- Cuando estamos añadiendo un usuario a la incidencia, si le damos a buscar más, saldra por defecto el filtro de usuario internos, esto lo hace el context-->
<!-- Para saber el nombre del campo "Usuarios internos" desde Usuarios pulsamos Editar SearchView -->
                            <field name="user_id" context="{'search_default_filter_no_share': 1}" options="{'no_open': True, 'no_quick': True}"/>
                            <field name="user_phone"/>
<!-- con - options="{'no_open': True, 'no_create': True}" - desaparece la flecha para acceder dentro de la clínica y no deja crear-->
<!-- con - options="{'no_open': True}" - desaparece la flecha para acceder dentro de la clínica-->
<!-- con - options="{'no_open': True 'no_quick_create': True}" - desaparece la flecha para acceder dentro de la clínica y solo aparece el botón de crear y editar-->
<!-- available en clinicas hace que cuando hay una incidencia y haya que asignarle un hospital, solo muestre los hospitales que estan en available -->
                            <field name="clinic_id" domain="[('available','=',True)]" options="{'no_open': True, 'no_quick_create': True}" />
                            <field name="cost"/>
                            <field name="player_id"/>
                        </group>

                        <group>
                            <field name="date"/>
<!-- boolean togle, casilla de check, si check = true, no check = false-->
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="assistance" widget="boolean_toggle"/>
                        </group>
                    </group>
<!-- Notebook és el menu de selección de pestañas, en este ejemplo, Descripción y Solución -->
                    <notebook>
                        <page name="actions" string="Actions to do">
                            <field name="action_ids" context="{'default_state': state}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description"/>
                        </page>
                        <page name="solution" string="Solution">
                            <field name="solution"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sport_issue_view_search" model="ir.ui.view">
        <field name="name">sport.issue.view.search</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <search string="Incidencias">
                <field name="name"/>
                <field name="user_id"/>
                <field name="clinic_id"/>
                <field name="tag_ids"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="User" name="user" context="{'group_by':'user_id'}"/>
                <filter string="Date" name="date" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="sport_issue_view_kanban" model="ir.ui.view">
        <field name="name">sport_issue.view.kanban</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="user_id"/>
                <field name="clinic_id"/>
                <field name="tag_ids"/>
                <field name="date"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-menu">
                        <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <ul class="oe_kanban_colorpicker" data-field="color"></ul>
                    </t>
                    
                    <t t-name="kanban-box">
                    <div t-att-class="
                        (selection_mode and kanban_color(record.color.raw_value) or '')
                        + ' oe_kanban_card d-flex flex-column'
                    ">
                        <div class="oe_kanban_content flex-grow-1">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                        </div>

                        <div class="text-muted">
                            <field name="date"/>
                        </div>

                        <div class="mt-1">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </div>
                        </div>

                        <div class="oe_kanban_footer">
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                            <field name="clinic_id"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                            <field name="user_id" widget="many2one_avatar_user" domain="[('share','=',False)]"/>
                            </div>
                        </div>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sport_issue_view_pivot" model="ir.ui.view">
        <field name="name">sport_issue.view.pivot</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <pivot string="Issues">
                <field name="user_id" type="row"/>                
                <field name="date" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>


    <record id="sport_issue_view_calendar" model="ir.ui.view">
        <field name="name">sport_issue.view.calendar</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <calendar string="Issues Calendar" date_start="date" color="user_id">
                <field name="name"/>
                <field name="user_id"/>
                <field name="clinic_id"/>
            </calendar>
        </field>
    </record>

    <record id="sport_issue_view_graph" model="ir.ui.view">
        <field name="name">sport_issue.view.graph</field>
        <field name="model">sport.issue</field>
        <field name="arch" type="xml">
            <graph string="Issues Analysis" type="bar">
                <field name="user_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_sport_issue" model="ir.actions.act_window">
        <field name="name">Sport Issues</field>
        <field name="res_model">sport.issue</field>
        <field name="view_mode">tree,form,kanban,pivot,graph,calendar</field>
    <!-- LIMPIA vistas antiguas y asigna todas -->
        <field name="view_ids" eval="[(5,0,0),
        (0,0,{'view_mode':'kanban','view_id':ref('sport_issue_view_kanban')}),
        (0,0,{'view_mode':'tree','view_id':ref('sport_issue_view_tree')}),
        (0,0,{'view_mode':'form','view_id':ref('sport_issue_view_form')}),
        (0,0,{'view_mode':'pivot','view_id':ref('sport_issue_view_pivot')}),
        (0,0,{'view_mode':'graph','view_id':ref('sport_issue_view_graph')}),
        (0,0,{'view_mode':'calendar','view_id':ref('sport_issue_view_calendar')}),
        ]"/>

        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a sport issue
            </p>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<record id="action_sport_issue" model="ir.actions.act_window">
    <field name="name">Sport Issues</field>
    <field name="res_model">sport.issue</field>
    <field name="view_mode">tree,form,kanban</field>
    <field name="context">{}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a new sport issue
        </p>
    </field>
</record>

<menuitem
    id="sport_menu"
    name="Sport Association"
    sequence="10"/>

<menuitem
    id="sport_issue_menu"
    name="Sport Issues"
    action="sports_association.action_sport_issue"
    parent="sports_association.sport_menu"
    sequence="10"/>
    
<menuitem
    id="sport_clinic_menu"
    name="Sport Clinics"
    action="sports_association.action_sport_clinic"
    parent="sports_association.sport_menu"
    sequence="20"/>

<menuitem
    id="sport_tag_menu"
    name="Sport Issue Tag"
    action="sports_association.sport_issue_tag_action"
    parent="sports_association.sport_menu"
    sequence="40"/>

    <menuitem
    id="sport_team_menu"
    name="Sport Team"
    action="sports_association.sport_team_action"
    parent="sports_association.sport_menu"
    sequence="50"/>

    <menuitem
    id="sport_player_menu"
    name="Sport Player"
    action="sports_association.sport_player_action"
    parent="sports_association.sport_menu"
    sequence="60"/>

    <menuitem
    id="sport_sport_menu"
    name="Sport"
    action="sports_association.sport_sport_action"
    parent="sports_association.sport_menu"
    sequence="70"/>

    <menuitem
    id="sport_ticket_menu"
    name="Sport Ticket"
    action="sports_association.sport_ticket_action"
    parent="sports_association.sport_menu"
    sequence="80"/>
</odoo>

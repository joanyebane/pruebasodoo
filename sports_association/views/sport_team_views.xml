<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sport_team_view_tree" model="ir.ui.view">
        <field name="name">sport_team.view.tree</field>
        <field name="model">sport.team</field>
        <field name="arch" type="xml">
            <tree string="Team">
                <field name="name"/>
                <field name="sport_id"/>
            </tree>
        </field>
    </record>

    <record id="sport_team_view_form" model="ir.ui.view">
        <field name="name">sport_team.view.form</field>
        <field name="model">sport.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <header>
<!-- botón de añadir a un equipo todos los jugadores que no tienen equipo (están libres)-->
                    <button string="Add free players" name="action_add_players" type="object" class="btn-warning"/>
                </header>
                <sheet>
<!-- smart button para acceso directo a los jugadores del equipo -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_players" class="oe_stat_button" icon="fa-users">
                            <field string="Players" name="player_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Issue Name"/>                       
                        </h1>
                    </div>
                        <group>
                            <field name="sport_id"/>
                            <field name="player_count"/>
                        </group>
                        <group>
                            <field name="sport_id"/>
                        </group>
                    <notebook>
<!-- con el delete=false evitamos que si borramos el jugador desde el equipo se borre de forma permanente. Con la fila de options, si 
desde la pestaña equipo, en un jugador borramos el equipo, se quita el jugador del equipo sin elimanrlo complemente-->
                        <page name="players" string="Players">
                            <!--le especificamos que queremos que coja la vista simple
                            <field name="player_ids" context="{'tree_view_ref':'sports_association.sport_player_view_simple_tree','form_view_ref':'sports_association.sport_player_view_simple_form'}"> -->
                            <field name="player_ids">    
                                <tree editable="bottom" delete="false">
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="position"/>
                                    <field name="starter" widget="boolean_toggle"/>
                                    <field name="team_id" options="{'no_create': True, 'no_open': True}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sport_team_view_kanban" model="ir.ui.view">
        <field name="name">sport_team.view.kanban</field>
        <field name="model">sport.team</field>
        <field name="arch" type="xml">
            <kanban default_group_by="sport_id">
                <field name="name"/>
                <field name="logo"/>
                <field name="player_count"/>
                <templates>
                    <t t-name="kanban-menu">
                        <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <!-- <ul class="oe_kanban_colorpicker" data-field="color"></ul> -->
                    </t>
                    
                    <t t-name="kanban-box">

                    <div t-att-class="
                        (selection_mode and kanban_color(record.color.raw_value) or '')
                        + ' oe_kanban_card d-flex flex-column'
                    ">
                        <div class="oe_kanban_content flex-grow-1">
                            <field name="logo" widget="image" class="oe_avatar"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                        </div>
                        <div class="o_kanban_record_subtitle">
                            <field name="player_count"/>
                        </div>
                        <!-- ✅ Fecha 
                        <div class="text-muted">
                            <field name="date"/>
                        </div> -->

                        <!-- ✅ Etiquetas 
                        <div class="mt-1">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </div>-->
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

        <record id="sport_team_action" model="ir.actions.act_window">
        <field name="name">Sport Player</field>
        <field name="res_model">sport.team</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new sport team
            </p>
        </field>
    </record>

</odoo>